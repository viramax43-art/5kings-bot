# Скопируйте в .env и заполните
LOGIN=Игрок121323323
PASSWORD=

# forest | chaos | both
MODE=forest

# false = видно окно браузера (рекомендуется)
HEADLESS=false

# медленнее = человекоподобнее
FOREST_DELAY_MIN_MS=500
FOREST_DELAY_MAX_MS=1100

# собирать деревья/травы/кристаллы (руда — FORCE_ORE=true)
COLLECT_ALL=true
FORCE_ORE=false

# полный цикл леса
FOREST_EQUIP_TOOL=true
FOREST_AUTO_SEARCH=true
FOREST_SEARCH_WAIT_MS=32000
FOREST_AUTO_HEAL=true

# королевские хаосы
CHAOS_AUTO_JOIN=true
CHAOS_AUTO_CREATE=true
CHAOS_MIN_LVL=0
CHAOS_MAX_LVL=50
CHAOS_MAXP=6
CHAOS_FIGHT=true
# обновлять список, если заявок нет N мс
CHAOS_RELOAD_EMPTY_MS=15000

# бой (humanizer)
BATTLE_DELAY_MIN_MS=700
BATTLE_DELAY_MAX_MS=1800
BATTLE_HEAL_HP_PCT=45

# MODE=both: сначала хаосы, или периодически уходить в хаосы из леса
# CHAOS_FIRST=false
# BOTH_CHAOS_INTERVAL_MS=0
